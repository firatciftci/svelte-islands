// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`init's handle > handles a Redis store and an existing handle 1`] = `
"import { sequence } from "@sveltejs/kit/hooks";
import { REDIS_URL } from "$app/env/private";
import { Redis } from "ioredis";
import { compressed, redisStore } from "svelte-islands/stores";
import { handle as islands } from "svelte-islands/server";

const client = new Redis(REDIS_URL);

const app = async ({ event, resolve }) => resolve(event);

export const handle = sequence(islands({ store: compressed(redisStore(client, { ttl: 60 * 60 * 24 * 30 })) }), app);
"
`;

exports[`init's handle > handles a local handle in an export list 1`] = `
"import { sequence } from "@sveltejs/kit/hooks";
import { handle as islands } from "svelte-islands/server";

const handle = async ({ event, resolve }) => resolve(event);

export { handleWithIslands as handle };

const handleWithIslands = sequence(islands(), handle);
"
`;

exports[`init's handle > handles a missing file 1`] = `
"import { handle as islands } from "svelte-islands/server";

export const handle = islands();
"
`;

exports[`init's handle > handles a name the rename would take 1`] = `
"import { createApp } from "$lib/server/app";
import { sequence } from "@sveltejs/kit/hooks";
import { handle as islands } from "svelte-islands/server";

const app = createApp();

const app2 = async ({ event, resolve }) => app.run(event, resolve);

export const handle = sequence(islands(), app2);
"
`;

exports[`init's handle > handles a plain function 1`] = `
