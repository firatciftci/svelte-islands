import { sequence } from "@sveltejs/kit/hooks";
import { handle as islands } from "svelte-islands/server";

const app: Handle = async ({ event, resolve }) => resolve(event);

export const handle = sequence(islands(), app);
"
`;

exports[`init's handle > handles an R2 store in a new file 1`] = `
"import { env } from "cloudflare:workers";
import { r2Store } from "svelte-islands/stores";
import { handle as islands } from "svelte-islands/server";

export const handle = islands({ store: r2Store(() => env.PARTS), memory: 16 * 1024 * 1024 });
"
`;

