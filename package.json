{
  "name": "svelte-islands",
  "version": "0.5.0",
  "description": "Islands for SvelteKit: content-addressed page data, server HTML adopted without hydration, and skeletons learned from your own markup.",
  "keywords": [
    "svelte",
    "sveltekit",
    "islands",
    "partial-hydration",
    "skeleton",
    "performance"
  ],
  "license": "MIT",
  "author": "Firat Ciftci <2052855+firatciftci@users.noreply.github.com>",
  "homepage": "https://github.com/firatciftci/svelte-islands",
  "bugs": {
    "url": "https://github.com/firatciftci/svelte-islands/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/firatciftci/svelte-islands.git"
  },
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "sideEffects": [
    "**/*.css",
    "./dist/runtime.js",
    "./dist/server.js"
  ],
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "svelte": "./dist/server.js",
      "default": "./dist/server.js"
    },
    "./stores": {
      "types": "./dist/stores.d.ts",
      "default": "./dist/stores.js"
    },
    "./devtools": {
      "types": "./dist/devtools.svelte.d.ts",
      "svelte": "./dist/devtools.svelte",
      "default": "./dist/devtools.svelte"
    },
    "./sw": {
      "types": "./dist/sw.d.ts",
      "default": "./dist/sw.js"
    },
    "./eslint": {
      "types": "./dist/eslint.d.ts",
      "default": "./dist/eslint.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "svelte-package --watch",
    "prepare": "svelte-kit sync || echo ''",
    "build": "svelte-kit sync && svelte-package && publint",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && cd fixtures/app && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc --noEmit -p src/service-worker/tsconfig.json",
    "test": "svelte-kit sync && vitest run",
    "size": "node --experimental-strip-types scripts/size.ts",
    "test:e2e": "pnpm run fixture && playwright test",
    "fixture": "svelte-kit sync && cd fixtures/app && svelte-kit sync && vite build && FIXTURE_ADAPTER=static vite build",
    "lint": "knip && SVELTE_ESLINT_PARSER_EXPERIMENTAL_TS_SYS_HOOK=1 eslint .",
    "lint:fix": "knip --fix && SVELTE_ESLINT_PARSER_EXPERIMENTAL_TS_SYS_HOOK=1 eslint --fix .",
    "format": "oxfmt --check",
    "format:fix": "oxfmt",
    "release": "bumpp"
  },
  "dependencies": {
    "devalue": "^5.9.4"
  },
  "peerDependencies": {
    "@sveltejs/kit": "^3.0.0",
    "eslint": "^9.0.0 || ^10.0.0",
    "svelte": "^5.57.0"
  },
  "peerDependenciesMeta": {
    "eslint": {
      "optional": true
    }
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@aws-sdk/client-s3": "^3.1161.0",
    "@playwright/test": "^1.64.1",
    "@sveltejs/adapter-node": "^6.0.1",
    "@sveltejs/adapter-static": "^4.0.1",
    "@sveltejs/kit": "^3.1.0",
    "@sveltejs/package": "^3.0.2",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^24.19.2",
    "@typescript-eslint/parser": "8.72.1",
    "bumpp": "^12.3.0",
    "eslint": "^10.12.0",
    "eslint-plugin-erasable-syntax-only": "^0.7.2",
    "eslint-plugin-slop": "^0.1.3",
    "eslint-plugin-sonarjs": "^4.2.2",
    "eslint-plugin-svelte": "^3.23.1",
    "fast-check": "^4.10.2",
    "ioredis": "^6.0.0",
    "knip": "^6.41.0",
    "oxfmt": "^0.72.0",
    "publint": "^0.3.25",
    "redis": "^6.3.1",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.7",
    "svelte-eslint-parser": "1.10.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@12.11.2",
  "bin": {
    "svelte-islands": "./dist/cli.js"
  }
}
