{
  "name": "svelte-islands",
  "version": "0.1.0",
  "description": "Islands for SvelteKit: content-addressed page data, server HTML adopted without hydration, and skeletons learned from your own markup.",
  "keywords": [
    "svelte",
    "sveltekit",
    "islands",
    "partial-hydration",
    "skeleton",
    "performance"
  ],
  "license": "MIT",
  "author": "Firat Ciftci <2052855+firatciftci@users.noreply.github.com>",
  "homepage": "https://github.com/firatciftci/svelte-islands",
  "bugs": {
    "url": "https://github.com/firatciftci/svelte-islands/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/firatciftci/svelte-islands.git"
  },
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": [
    "**/*.css",
    "./dist/runtime.js",
    "./dist/server.js"
  ],
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "svelte": "./dist/server.js",
      "default": "./dist/server.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "svelte-package --watch",
    "prepare": "svelte-kit sync || echo ''",
    "build": "svelte-kit sync && svelte-package && publint",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "lint": "knip && SVELTE_ESLINT_PARSER_EXPERIMENTAL_TS_SYS_HOOK=1 eslint .",
    "lint:fix": "knip --fix && SVELTE_ESLINT_PARSER_EXPERIMENTAL_TS_SYS_HOOK=1 eslint --fix .",
    "format": "oxfmt --check",
    "format:fix": "oxfmt",
    "release": "bumpp"
  },
  "dependencies": {
    "devalue": "^5.9.4"
  },
  "peerDependencies": {
    "@sveltejs/kit": "^3.0.0",
    "svelte": "^5.57.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@sveltejs/adapter-static": "^4.0.1",
    "@sveltejs/kit": "^3.1.0",
    "@sveltejs/package": "^3.0.2",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^24.19.2",
    "bumpp": "^12.3.0",
    "eslint": "^10.12.0",
    "eslint-plugin-erasable-syntax-only": "^0.7.2",
    "eslint-plugin-slop": "^0.1.3",
    "eslint-plugin-sonarjs": "^4.2.2",
    "eslint-plugin-svelte": "^3.23.1",
    "knip": "^6.41.0",
    "oxfmt": "^0.72.0",
    "publint": "^0.3.25",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.7",
    "typescript": "^6.0.3",
    "vite": "^8.3.4"
  },
  "packageManager": "pnpm@12.11.2"
}
